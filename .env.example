# Copy this file to `.env` and fill in what you need:
#
#     cp .env.example .env
#
# `.env` is gitignored and never committed.  Nothing in this repo sources it
# automatically — export it yourself before running the pipeline:
#
#     set -a; source .env; set +a
#     python main.py --image data/indoor_images/<photo>.jpg
#
# Every variable below is optional in the sense that it has a default; the
# defaults assume the local GPU servers described in README "## Services".


# ─────────────────────────────────────────────────────────────────────────────
# VLM backend — scene analysis, verification, counting
#   Router: object_placement/vlm_backend.py
# ─────────────────────────────────────────────────────────────────────────────
# Pick ONE: a local Qwen server, or a hosted GPT API.
#   qwen = local Qwen3-VL server on port 8080 (default, no key needed, needs a GPU)
#   gpt  = any OpenAI-compatible chat/completions API (no GPU needed)
SCENEWEAVE_VLM_BACKEND=qwen

# --- hosted GPT backend (SCENEWEAVE_VLM_BACKEND=gpt) -------------------------
# Key. NVIDIA_API_KEY / SCENEWEAVE_GPT55_KEY are accepted as aliases; if no key
# is set at all, the router says so and falls back to the local Qwen server.
OPENAI_API_KEY=
# Model id and endpoint. Defaults target api.openai.com; set both to point at
# any other OpenAI-compatible provider. An NVIDIA_API_KEY (or the historical
# backend name "gpt55") instead defaults to NVIDIA's gateway with
# openai/openai/gpt-5.5.
SCENEWEAVE_VLM_MODEL=gpt-5.5
SCENEWEAVE_VLM_URL=https://api.openai.com/v1/chat/completions
NVIDIA_API_KEY=
SCENEWEAVE_GPT55_KEY=

# --- local Qwen backend (SCENEWEAVE_VLM_BACKEND=qwen) ------------------------
# Override the local Qwen chat endpoint.
VLM_API_URL=http://localhost:8080/v1/chat/completions
# Set to any value to print per-stage timings and per-call VLM logs.
SCENEWEAVE_VLM_LOG=


# ─────────────────────────────────────────────────────────────────────────────
# Image edit — inpainting, empty-room generation, texture synthesis
#   Adapter: Qwen/image_edit_adapter.py
# ─────────────────────────────────────────────────────────────────────────────
# qwen   = local Qwen image-edit server on port 8000 (default, no key needed)
# gemini = Google / NVIDIA-gateway image API
SCENEWEAVE_IMG_EDIT=qwen
GEMINI_API_KEY=
SCENEWEAVE_GEMINI_MODEL=gemini-2.5-flash-image
# Only needed when SCENEWEAVE_GEMINI_MODEL is a slash-style NVIDIA-gateway id
# (e.g. gcp/google/gemini-3-pro-image-preview) instead of a direct Gemini model.
SCENEWEAVE_GEMINI_GATEWAY_KEY=
# Retries when Gemini returns text but no image (default 3).
SCENEWEAVE_GEMINI_NOIMAGE_RETRIES=3
# Override the local Qwen image-edit endpoint.
SCENEWEAVE_QWEN_IMG_EDIT_URL=http://localhost:8000/generate


# ─────────────────────────────────────────────────────────────────────────────
# 3D generation — Hunyuan3D (the only backend; SAM3D was removed)
#   Client: object_placement/furniture/object_generation_sam3d.py
# ─────────────────────────────────────────────────────────────────────────────
HUNYUAN_SERVER=http://localhost:8081
# Per-object read timeout in seconds (default 300).
SCENEWEAVE_HUNYUAN_TIMEOUT=300
# Marching-cubes octree resolution (default 128).
SCENEWEAVE_HUNYUAN_OCTREE=128


# ─────────────────────────────────────────────────────────────────────────────
# Segmentation — LocateAnything → SAM2, run cross-env via subprocess
#   Driver: object_placement/segmentation_la_sam2.py
#
# REQUIRED: the two worker scripts are NOT shipped in this repo.  Point these
# at the directories that hold `la_emit_boxes.py` and `sam2_from_boxes.py`, or
# the segment_wall_objects / segment_furniture / segment_decorations stages
# will fail.  See MODELS_AND_PATHS.md.
# ─────────────────────────────────────────────────────────────────────────────
SCENEWEAVE_LA_DIR=/path/to/eagle/Embodied
SCENEWEAVE_SAM2_DIR=/path/to/lang-segment-anything
SCENEWEAVE_LA_ENV=eagle-embodied
SCENEWEAVE_SAM2_ENV=lang-sam
SCENEWEAVE_SAM2_TYPE=sam2.1_hiera_small
# Root of the conda install whose envs/ holds the two envs above.
CONDA_ROOT=$HOME/miniconda3
# Set to 1 to skip the VLM verification pass after box detection.
SCENEWEAVE_NO_SEGMENT_VERIFY=


# ─────────────────────────────────────────────────────────────────────────────
# Lighting — Blender Cycles render (optional; degrades gracefully if unset)
#   lighting_module/render_blender.py, lighting_module/_blender_cycles.py
# ─────────────────────────────────────────────────────────────────────────────
BLENDER_BIN=
# Light power / exposure overrides, all optional.
SCENEWEAVE_LAMP_POWER=70.0
SCENEWEAVE_WINDOW_POWER=1300.0
SCENEWEAVE_CEILING_POWER=250.0
SCENEWEAVE_EMISSIVE_SCALE=1.0


# ─────────────────────────────────────────────────────────────────────────────
# Optional model checkpoints
# ─────────────────────────────────────────────────────────────────────────────
# SAM ViT-H, used only as a carpet-mask fallback in place_furniture_vggt.py.
# Defaults to checkpoints/sam_vit_h_4b8939.pth; silently skipped if absent.
SCENEWEAVE_SAM_CKPT=


# ─────────────────────────────────────────────────────────────────────────────
# Evaluation harness — evaluation/evaluation.sh
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GPT_EVAL_MODEL=gpt-4o
REF_DIR=/path/to/input_photos
REGEN_DIR=/path/to/3D-RE-GEN/results_batch
GEN3DSR_DIR=/path/to/Gen3DSR/out
# Comma-separated roots holding this pipeline's outputs; earlier roots win.
HARMONY_ROOTS=/path/to/outputs/Artifact,/path/to/outputs/_processed


# ─────────────────────────────────────────────────────────────────────────────
# Data fetching — data/image_fetcher.py (only needed to download sample photos)
# ─────────────────────────────────────────────────────────────────────────────
UNSPLASH_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Debug / ablation switches
#
# A further ~40 SCENEWEAVE_* variables gate debug renders and paper ablations
# (SCENEWEAVE_ABLATE_*, SCENEWEAVE_NO_*, *_DEBUG, …).  They are not part of the
# normal run.  To list them:
#
#     grep -rho 'SCENEWEAVE_[A-Z0-9_]*' --include='*.py' . | sort -u
# ─────────────────────────────────────────────────────────────────────────────
